rules_version = '2';

// Assumed data model:
// Collection path: artifacts/{appId}/users/{userId}/orders/{orderId}
// Document ID: generated by Firestore.
// Fields: fullName, email, address, cartItems, grandTotal, currency,
//         createdAt; all required and immutable after creation.
// cartItems contains 1-6 product maps from the app's six-item catalog.
// Each product map contains id, name, category, tags, price, description,
// image, and quantity. Order documents contain personal information and are
// readable only by the authenticated user whose UID is in the path.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(data, userId) {
      return !('uid' in data) || data.uid == userId;
    }

    function uidNotModified() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
    }

    function validTags(tags) {
      return tags is list &&
        tags.size() <= 10 &&
        (tags.size() < 1 || (tags[0] is string && tags[0].size() <= 40)) &&
        (tags.size() < 2 || (tags[1] is string && tags[1].size() <= 40)) &&
        (tags.size() < 3 || (tags[2] is string && tags[2].size() <= 40)) &&
        (tags.size() < 4 || (tags[3] is string && tags[3].size() <= 40)) &&
        (tags.size() < 5 || (tags[4] is string && tags[4].size() <= 40)) &&
        (tags.size() < 6 || (tags[5] is string && tags[5].size() <= 40)) &&
        (tags.size() < 7 || (tags[6] is string && tags[6].size() <= 40)) &&
        (tags.size() < 8 || (tags[7] is string && tags[7].size() <= 40)) &&
        (tags.size() < 9 || (tags[8] is string && tags[8].size() <= 40)) &&
        (tags.size() < 10 || (tags[9] is string && tags[9].size() <= 40));
    }

    function validCartItem(item) {
      return item is map &&
        item.keys().hasOnly([
          'id', 'name', 'category', 'tags', 'price',
          'description', 'image', 'quantity'
        ]) &&
        item.keys().hasAll([
          'id', 'name', 'category', 'tags', 'price',
          'description', 'image', 'quantity'
        ]) &&
        item.id is int &&
        item.id >= 1 &&
        item.id <= 6 &&
        item.name is string &&
        item.name.size() > 0 &&
        item.name.size() <= 120 &&
        item.category is string &&
        item.category.size() > 0 &&
        item.category.size() <= 40 &&
        validTags(item.tags) &&
        item.price is number &&
        item.price >= 0 &&
        item.price <= 10000000 &&
        item.description is string &&
        item.description.size() <= 1000 &&
        item.image is string &&
        item.image.size() <= 2048 &&
        item.image.matches('^https://.*') &&
        item.quantity is int &&
        item.quantity >= 1 &&
        item.quantity <= 99;
    }

    function validCartItems(items) {
      return items is list &&
        items.size() >= 1 &&
        items.size() <= 6 &&
        (items.size() < 1 || validCartItem(items[0])) &&
        (items.size() < 2 || validCartItem(items[1])) &&
        (items.size() < 3 || validCartItem(items[2])) &&
        (items.size() < 4 || validCartItem(items[3])) &&
        (items.size() < 5 || validCartItem(items[4])) &&
        (items.size() < 6 || validCartItem(items[5]));
    }

    function validOrder(data, userId) {
      return data.keys().hasAll([
          'fullName', 'email', 'address', 'cartItems',
          'grandTotal', 'currency', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'fullName', 'email', 'address', 'cartItems',
          'grandTotal', 'currency', 'createdAt'
        ]) &&
        uidUnchanged(data, userId) &&
        data.fullName is string &&
        data.fullName.size() >= 2 &&
        data.fullName.size() <= 120 &&
        data.email is string &&
        data.email.size() <= 254 &&
        data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$') &&
        data.address is string &&
        data.address.size() >= 6 &&
        data.address.size() <= 500 &&
        validCartItems(data.cartItems) &&
        data.grandTotal is number &&
        data.grandTotal >= 0 &&
        data.grandTotal <= 100000000 &&
        data.currency == 'INR' &&
        data.createdAt is string &&
        data.createdAt.size() <= 40 &&
        data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*Z$');
    }

    match /artifacts/{appId}/users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        validOrder(request.resource.data, userId);
      allow update, delete: if false && uidNotModified();
    }
  }
}
